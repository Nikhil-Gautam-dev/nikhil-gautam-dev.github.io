---
import { site } from "../data/site";
import heroIllustration from "../assets/hero-illustration.png";
import profileImage from "../assets/profile-img.png";
---

<section class="hero" aria-label="Introduction">
  <div class="container hero-inner">
    <!-- Left: text content -->
    <div class="hero-content">
      <!-- Identity label -->
      <p class="hero-label" data-hero="label">
        <span class="label-star" aria-hidden="true">✳</span>
        <span>Backend Engineer</span>
        <span class="hero-label-sep" aria-hidden="true">·</span>
        <span>Builder</span>
        <span class="hero-label-sep" aria-hidden="true">·</span>
        <span>Problem Solver</span>
      </p>

      <!-- Name -->
      <h1 class="hero-name" aria-label="Nikhil Gautam">
        <span class="hero-firstname" data-hero="first">NIKHIL</span>
        <span class="hero-lastname" data-hero="last">GAUTAM</span>
      </h1>

      <!-- Positioning statement -->
      <p class="hero-tagline" data-hero="tagline">
        I build backend systems, APIs, and products with a focus on reliability,
        scalability, and clean architecture.
      </p>

      <!-- CTAs -->
      <div class="hero-ctas" data-hero="ctas">
        <a href="/work" class="btn">
          View Work
          <span class="arrow" aria-hidden="true">→</span>
        </a>
        <a
          href={site.github}
          class="btn btn-ghost"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub profile (opens in new tab)"
        >
          GitHub
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
        <a
          href={site.linkedin}
          class="btn btn-ghost"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn profile (opens in new tab)"
        >
          LinkedIn
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <!-- Right: illustration -->
    <div class="hero-visual" data-hero="visual" aria-hidden="true">
      <div class="hero-image-wrap">
        <img
          src={profileImage.src}
          alt="Backend code illustration — JWT auth and database transaction"
          class="hero-image"
          width="540"
          height="540"
          loading="eager"
          decoding="async"
        />
        <!-- Decorative corner accent -->
        <div class="hero-image-corner" aria-hidden="true"></div>
        <div class="hero-image-corner-bottom" aria-hidden="true"></div>
      </div>
    </div>
  </div>
</section>

<script>
  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (!prefersReducedMotion) {
    const elements = document.querySelectorAll<HTMLElement>("[data-hero]");
    const delays: Record<string, number> = {
      label: 0,
      first: 150,
      last: 280,
      tagline: 460,
      ctas: 600,
      visual: 200,
    };

    elements.forEach((el) => {
      const key = el.getAttribute("data-hero") ?? "";
      const delay = delays[key] ?? 0;

      el.style.opacity = "0";
      el.style.transform =
        key === "visual" ? "translateY(16px)" : "translateY(20px)";

      setTimeout(() => {
        el.style.transition =
          "opacity 0.65s cubic-bezier(0.25, 0.46, 0.45, 0.94), transform 0.65s cubic-bezier(0.25, 0.46, 0.45, 0.94)";
        el.style.opacity = "1";
        el.style.transform = "translateY(0)";
      }, delay);
    });
  }
</script>

<style>
  .hero {
    padding-top: clamp(3rem, 7vw, 6rem);
    padding-bottom: clamp(3rem, 7vw, 6rem);
  }

  /* Two-column grid: text left, image right */
  .hero-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  /* ── LEFT COLUMN ─────────────────────────── */
  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    min-width: 0; /* prevents overflow */
  }

  /* Identity label */
  .hero-label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    flex-wrap: wrap;
  }

  .label-star {
    color: var(--accent);
    font-size: 0.8rem;
  }

  .hero-label-sep {
    color: var(--bg-border);
  }

  /* Name */
  .hero-name {
    display: flex;
    flex-direction: column;
    margin: 0;
    line-height: 0.92;
  }

  .hero-firstname,
  .hero-lastname {
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 11vw, 10rem);
    letter-spacing: -0.01em;
    color: var(--ink);
    line-height: 0.93;
    display: block;
  }

  /* Outlined last name for visual contrast */
  .hero-lastname {
    color: transparent;
    -webkit-text-stroke: 2px var(--ink);
  }

  /* Tagline */
  .hero-tagline {
    font-size: clamp(0.9rem, 1.6vw, 1.05rem);
    line-height: 1.75;
    color: var(--muted);
    max-width: 42ch;
  }

  /* CTAs */
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  .btn-ghost {
    border-color: var(--bg-border);
    color: var(--muted);
    background: transparent;
  }

  .btn-ghost:hover {
    border-color: var(--ink);
    background: transparent;
    color: var(--ink);
  }

  .btn-ghost .arrow {
    transition: transform 0.2s ease;
  }

  .btn-ghost:hover .arrow {
    transform: translate(3px, -3px);
  }

  /* ── RIGHT COLUMN ────────────────────────── */
  .hero-visual {
    flex-shrink: 0;
    width: clamp(260px, 35vw, 480px);
  }

  .hero-image-wrap {
    position: relative;
    width: 100%;
  }

  .hero-image {
    width: 100%;
    height: auto;
    display: block;
    /* Very subtle border matching the editorial style */
    border: 1px solid var(--bg-border);
  }

  /* Orange corner accent — top-right decorative bracket */
  .hero-image-corner {
    position: absolute;
    top: -8px;
    right: -8px;
    width: 36px;
    height: 36px;
    border-top: 2px solid var(--accent);
    border-right: 2px solid var(--accent);
    pointer-events: none;
  }

  .hero-image-corner-bottom {
    position: absolute;
    width: 36px;
    height: 36px;
    border-bottom: 2px solid var(--accent);
    border-left: 2px solid var(--accent);
    pointer-events: none;
    bottom: -8px;
    left: -8px;
  }

  /* ── RESPONSIVE ──────────────────────────── */

  /* Tablet: tighten the image a bit */
  @media (max-width: 1024px) {
    .hero-inner {
      gap: clamp(2rem, 4vw, 3.5rem);
    }

    .hero-visual {
      width: clamp(220px, 30vw, 360px);
    }
  }

  /* Mobile: hide image, single column text only */
  @media (max-width: 768px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .hero-visual {
      display: none;
    }

    .hero-firstname,
    .hero-lastname {
      font-size: clamp(4rem, 16vw, 8rem);
    }
  }

  /* Small mobile: compact spacing */
  @media (max-width: 480px) {
    .hero-content {
      gap: 1.5rem;
    }

    .hero-ctas {
      gap: 0.6rem;
    }

    .hero-label {
      gap: 0.4rem;
    }
  }
</style>
