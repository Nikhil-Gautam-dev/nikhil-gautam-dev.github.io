---
import { site } from '../data/site';
import SectionHeading from './SectionHeading.astro';
---

<section class="section-py" aria-labelledby="contact-heading" id="contact">
  <div class="container">
    <SectionHeading
      id="contact-heading"
      label="Contact"
    />

    <div class="contact-inner">
      <div class="contact-statement">
        <h2 class="contact-heading">Let's build<br />something.</h2>
        <p class="contact-sub">
          Have a project, opportunity, or interesting problem?
          I'm always open to a conversation.
        </p>
      </div>

      <div class="contact-links">
        <a
          href={`mailto:${site.email}`}
          class="contact-primary-link"
          aria-label={`Send email to ${site.name}`}
        >
          <span class="contact-link-label">Email me</span>
          <span class="contact-link-arrow" aria-hidden="true">↗</span>
        </a>

        <button
          id="copy-email-btn"
          class="copy-email-btn"
          aria-label="Copy email address to clipboard"
          data-email={site.email}
        >
          <span class="copy-email-text">Copy email</span>
          <span class="copy-email-icon" aria-hidden="true">
            <svg class="icon-copy" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <svg class="icon-check" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </span>
        </button>

        <div class="contact-secondary-links">
          <a
            href={site.github}
            class="contact-social"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub profile (opens in new tab)"
          >
            GitHub <span aria-hidden="true">↗</span>
          </a>
          <a
            href={site.linkedin}
            class="contact-social"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn profile (opens in new tab)"
          >
            LinkedIn <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: start;
  }

  .contact-statement {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contact-heading {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 7vw, 5rem);
    letter-spacing: 0.02em;
    color: var(--ink);
    line-height: 1.0;
  }

  .contact-sub {
    font-size: 0.98rem;
    color: var(--muted);
    line-height: 1.7;
    max-width: 38ch;
  }

  /* Links */
  .contact-links {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-top: 0.5rem;
  }

  .contact-primary-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .contact-link-label {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 3rem);
    letter-spacing: 0.04em;
    color: var(--ink);
    transition: color 0.2s ease;
  }

  .contact-link-arrow {
    font-size: 1.5rem;
    color: var(--muted);
    transition: color 0.2s ease, transform 0.2s ease;
    margin-top: -0.4rem;
  }

  .contact-primary-link:hover .contact-link-label {
    color: var(--accent);
  }

  .contact-primary-link:hover .contact-link-arrow {
    color: var(--accent);
    transform: translate(3px, -3px);
  }

  .contact-secondary-links {
    display: flex;
    gap: 2rem;
  }

  .contact-social {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .contact-social:hover {
    color: var(--accent);
  }

  @media (max-width: 768px) {
    .contact-inner {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  /* Copy email button */
  .copy-email-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: transparent;
    border: 1px solid var(--bg-border);
    color: var(--muted);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.45rem 0.9rem;
    border-radius: 4px;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
    width: fit-content;
    font-family: inherit;
  }

  .copy-email-btn:hover {
    color: var(--ink);
    border-color: var(--ink);
  }

  .copy-email-btn.copied {
    color: var(--accent);
    border-color: var(--accent);
  }

  .copy-email-icon {
    display: flex;
    align-items: center;
    position: relative;
    width: 13px;
    height: 13px;
  }

  .icon-copy,
  .icon-check {
    position: absolute;
    top: 0;
    left: 0;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .icon-check {
    opacity: 0;
    transform: scale(0.7);
  }

  .copy-email-btn.copied .icon-copy {
    opacity: 0;
    transform: scale(0.7);
  }

  .copy-email-btn.copied .icon-check {
    opacity: 1;
    transform: scale(1);
  }
</style>

<script>
  const btn = document.getElementById('copy-email-btn') as HTMLButtonElement | null;
  if (btn) {
    btn.addEventListener('click', async () => {
      const email = btn.getAttribute('data-email') ?? '';
      try {
        await navigator.clipboard.writeText(email);
        const textEl = btn.querySelector('.copy-email-text');
        btn.classList.add('copied');
        if (textEl) textEl.textContent = 'Copied!';
        setTimeout(() => {
          btn.classList.remove('copied');
          if (textEl) textEl.textContent = 'Copy email';
        }, 2000);
      } catch {
        // Fallback for older browsers
        const ta = document.createElement('textarea');
        ta.value = email;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.focus();
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
    });
  }
</script>
