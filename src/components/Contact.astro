---
import { site } from '../data/site';
import SectionHeading from './SectionHeading.astro';
---

<section class="section-py" aria-labelledby="contact-heading" id="contact">
  <div class="container">
    <SectionHeading
      id="contact-heading"
      label="Contact"
    />

    <div class="contact-inner">
      <div class="contact-statement">
        <h2 class="contact-heading">Let's build<br />something.</h2>
        <p class="contact-sub">
          Have a project, opportunity, or interesting problem?
          I'm always open to a conversation.
        </p>
      </div>

      <div class="contact-links">
        <a
          href={`mailto:${site.email}`}
          class="contact-primary-link"
          aria-label={`Send email to ${site.name}`}
        >
          <span class="contact-link-label">Email me</span>
          <span class="contact-link-arrow" aria-hidden="true">↗</span>
        </a>

        <div class="contact-secondary-links">
          <a
            href={site.github}
            class="contact-social"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub profile (opens in new tab)"
          >
            GitHub <span aria-hidden="true">↗</span>
          </a>
          <a
            href={site.linkedin}
            class="contact-social"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn profile (opens in new tab)"
          >
            LinkedIn <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: start;
  }

  .contact-statement {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contact-heading {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 7vw, 5rem);
    letter-spacing: 0.02em;
    color: var(--ink);
    line-height: 1.0;
  }

  .contact-sub {
    font-size: 0.98rem;
    color: var(--muted);
    line-height: 1.7;
    max-width: 38ch;
  }

  /* Links */
  .contact-links {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-top: 0.5rem;
  }

  .contact-primary-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .contact-link-label {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 3rem);
    letter-spacing: 0.04em;
    color: var(--ink);
    transition: color 0.2s ease;
  }

  .contact-link-arrow {
    font-size: 1.5rem;
    color: var(--muted);
    transition: color 0.2s ease, transform 0.2s ease;
    margin-top: -0.4rem;
  }

  .contact-primary-link:hover .contact-link-label {
    color: var(--accent);
  }

  .contact-primary-link:hover .contact-link-arrow {
    color: var(--accent);
    transform: translate(3px, -3px);
  }

  .contact-secondary-links {
    display: flex;
    gap: 2rem;
  }

  .contact-social {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .contact-social:hover {
    color: var(--accent);
  }

  @media (max-width: 768px) {
    .contact-inner {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }
</style>
