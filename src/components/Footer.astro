---
import { site } from '../data/site';
---

<footer class="site-footer" role="contentinfo">
  <div class="container footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label={`${site.name} — Home`}>
          <span class="footer-initials">NG</span>
        </a>
        <div class="footer-brand-info">
          <span class="footer-name">{site.name}</span>
          <span class="footer-role">{site.role}</span>
        </div>
      </div>

      <nav class="footer-nav" aria-label="Footer navigation">
        <ul role="list">
          <li><a href="/work" class="footer-link">Work</a></li>
          <li><a href="/about" class="footer-link">About</a></li>
          <li><a href="/blog" class="footer-link">Blog</a></li>
          <li><a href="/contact" class="footer-link">Contact</a></li>
        </ul>
      </nav>

      <div class="footer-social">
        <a
          href={site.github}
          class="footer-social-link"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub profile (opens in new tab)"
        >
          GitHub ↗
        </a>
        <a
          href={site.linkedin}
          class="footer-social-link"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn profile (opens in new tab)"
        >
          LinkedIn ↗
        </a>
        <a
          href={`mailto:${site.email}`}
          class="footer-social-link"
          aria-label={`Send email to ${site.name}`}
        >
          Email ↗
        </a>
      </div>
    </div>

    <hr class="divider footer-divider" />

    <div class="footer-bottom">
      <p class="footer-copy">
        &copy; {new Date().getFullYear()} {site.name}
      </p>
      <p class="footer-built">
        Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="footer-astro-link">Astro</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--bg-border);
    margin-top: auto;
  }

  .footer-inner {
    padding-top: 3.5rem;
    padding-bottom: 2rem;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 3rem;
    align-items: start;
    margin-bottom: 3rem;
  }

  /* Brand */
  .footer-logo {
    text-decoration: none;
    display: inline-block;
  }

  .footer-initials {
    font-family: var(--font-display);
    font-size: 2.2rem;
    letter-spacing: 0.04em;
    color: var(--ink);
    line-height: 1;
    display: block;
    transition: color 0.2s ease;
  }

  .footer-logo:hover .footer-initials {
    color: var(--accent);
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-brand-info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .footer-name {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .footer-role {
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* Nav */
  .footer-nav ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    align-items: flex-end;
  }

  .footer-link {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-link:hover {
    color: var(--ink);
  }

  /* Social */
  .footer-social {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    align-items: flex-end;
  }

  .footer-social-link {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-social-link:hover {
    color: var(--accent);
  }

  /* Bottom bar */
  .footer-divider {
    margin-bottom: 1.5rem;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-copy,
  .footer-built {
    font-size: 0.7rem;
    color: var(--muted);
    letter-spacing: 0.06em;
  }

  .footer-astro-link {
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }

  .footer-astro-link:hover {
    color: var(--accent);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .footer-nav ul,
    .footer-social {
      align-items: flex-start;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 1rem 1.5rem;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }
</style>
