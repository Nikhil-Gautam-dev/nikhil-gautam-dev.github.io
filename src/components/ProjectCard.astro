---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const detailUrl = `/work/${project.slug}`;
---

<article class="project-row" aria-label={`Project: ${project.title}`}>
  <a href={detailUrl} class="project-row-link" tabindex="-1" aria-hidden="true"></a>
  <div class="project-row-inner">
    <div class="project-meta-left">
      <span class="project-number label label-accent" aria-hidden="true">{project.number}</span>
    </div>

    <div class="project-content">
      <div class="project-title-row">
        <h3 class="project-title">
          <a href={detailUrl} class="project-title-link">
            {project.title}
            <span class="project-title-arrow" aria-hidden="true">→</span>
          </a>
        </h3>
        <span class="project-category label">{project.category}</span>
      </div>
      <p class="project-description">{project.shortDescription}</p>
      <div class="project-tech" aria-label="Technologies used">
        {project.technologies.map((tech) => (
          <span class="tech-tag">{tech}</span>
        ))}
      </div>
    </div>

    {(project.links?.github || project.links?.live) && (
      <div class="project-links">
        {project.links.github && (
          <a
            href={project.links.github}
            class="project-ext-link"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${project.title} GitHub repository (opens in new tab)`}
            title="View source on GitHub"
          >
            GitHub ↗
          </a>
        )}
        {project.links.live && (
          <a
            href={project.links.live}
            class="project-ext-link project-ext-link--live"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${project.title} live demo (opens in new tab)`}
            title="View live project"
          >
            Live ↗
          </a>
        )}
      </div>
    )}
  </div>
</article>

<style>
  .project-row {
    position: relative;
    border-top: 1px solid var(--bg-border);
    cursor: pointer;
  }

  .project-row:last-child {
    border-bottom: 1px solid var(--bg-border);
  }

  .project-row-link {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: block;
  }

  .project-row-inner {
    position: relative;
    z-index: 1;
    pointer-events: none;
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    gap: 1.5rem;
    align-items: start;
    padding: 1.8rem 0;
    transition: background 0.2s ease, padding-left 0.25s ease;
  }

  .project-row:hover .project-row-inner {
    background: var(--bg-surface);
    padding-left: 0.5rem;
    padding-right: 0.5rem;
    margin: 0 -0.5rem;
  }

  /* Left: number */
  .project-meta-left {
    padding-top: 0.35rem;
  }

  /* Content */
  .project-content {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .project-title-row {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .project-title {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0;
    line-height: 1.3;
  }

  .project-title-link {
    color: var(--ink);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .project-title-arrow {
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.2s ease, transform 0.2s ease;
    color: var(--accent);
  }

  .project-row:hover .project-title-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .project-category {
    flex-shrink: 0;
  }

  .project-description {
    font-size: 0.875rem;
    color: var(--muted);
    line-height: 1.6;
    max-width: 60ch;
  }

  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.6rem;
    margin-top: 0.25rem;
  }

  .tech-tag {
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    background: var(--bg-surface);
    border: 1px solid var(--bg-border);
    padding: 0.15rem 0.5rem;
    border-radius: 2px;
  }

  /* External links */
  .project-links {
    position: relative;
    z-index: 2;
    pointer-events: auto;
    padding-top: 0.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    align-items: flex-end;
  }

  .project-ext-link {
    pointer-events: auto;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.2rem 0.6rem;
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    border: 1px solid var(--bg-border);
    transition: color 0.2s ease, border-color 0.2s ease;
    border-radius: 2px;
    white-space: nowrap;
  }

  .project-ext-link:hover {
    color: var(--ink);
    border-color: var(--muted);
  }

  .project-ext-link--live {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 30%, transparent);
  }

  .project-ext-link--live:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }

  /* Responsive */
  @media (max-width: 640px) {
    .project-row-inner {
      grid-template-columns: 2rem 1fr;
      gap: 1rem;
    }

    .project-links {
      display: none;
    }

    .project-category {
      display: none;
    }
  }
</style>
