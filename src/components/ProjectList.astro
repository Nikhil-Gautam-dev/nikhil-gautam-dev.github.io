---
import { projects, experiments } from '../data/projects';
import ProjectCard from './ProjectCard.astro';
import SectionHeading from './SectionHeading.astro';

interface Props {
  showExperiments?: boolean;
  limit?: number;
}

const { showExperiments = true, limit } = Astro.props;

const featuredProjects = limit
  ? projects.filter((p) => p.featured).slice(0, limit)
  : projects.filter((p) => p.featured);
---

<section class="section-py" aria-labelledby="work-heading" id="work">
  <div class="container">
    <SectionHeading
      id="work-heading"
      label="Selected Work"
      description="Engineering projects across backend systems, APIs, and infrastructure."
    />

    <div class="project-list" role="list">
      {featuredProjects.map((project) => (
        <div role="listitem">
          <ProjectCard project={project} />
        </div>
      ))}
    </div>

    {showExperiments && (
      <div class="experiments-section">
        <hr class="divider" style="margin-top: 4rem; margin-bottom: 2.5rem;" />
        <div class="experiments-header">
          <h3 class="experiments-title">Experiments</h3>
          <p class="experiments-desc">
            Smaller projects, technical explorations, and curiosity-driven work.
          </p>
        </div>
        <ul class="experiments-grid" role="list">
          {experiments.map((exp) => (
            <li class="experiment-item">
              <h4 class="experiment-name">{exp.title}</h4>
              <p class="experiment-desc">{exp.description}</p>
              <div class="experiment-tech" aria-label="Technologies">
                {exp.technologies.map((t) => (
                  <span class="tech-tag">{t}</span>
                ))}
              </div>
            </li>
          ))}
        </ul>
      </div>
    )}

    {!limit && (
      <div class="work-footer">
        <a href={`https://github.com/nikhil-gautam-dev`} class="link-arrow" target="_blank" rel="noopener noreferrer">
          More on GitHub <span class="arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    )}
  </div>
</section>

<style>
  .project-list {
    display: flex;
    flex-direction: column;
  }

  /* Experiments */
  .experiments-header {
    margin-bottom: 2rem;
  }

  .experiments-title {
    font-family: var(--font-display);
    font-size: 1.8rem;
    letter-spacing: 0.04em;
    color: var(--ink);
    margin-bottom: 0.5rem;
  }

  .experiments-desc {
    font-size: 0.875rem;
    color: var(--muted);
  }

  .experiments-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.5rem;
    list-style: none;
  }

  .experiment-item {
    border: 1px solid var(--bg-border);
    padding: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .experiment-item:hover {
    border-color: var(--muted);
    background: var(--bg-surface);
  }

  .experiment-name {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .experiment-desc {
    font-size: 0.8rem;
    color: var(--muted);
    line-height: 1.5;
    flex: 1;
  }

  .experiment-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 0.25rem;
  }

  .tech-tag {
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    border: 1px solid var(--bg-border);
    padding: 0.1rem 0.4rem;
    border-radius: 2px;
  }

  .work-footer {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--bg-border);
  }
</style>
