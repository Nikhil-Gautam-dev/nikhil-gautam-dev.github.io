---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

interface Props {
  currentPost: CollectionEntry<"blog">;
}

const { currentPost } = Astro.props;

// Fetch all published posts except the current one
const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const otherPosts = allPosts.filter((p) => p.id !== currentPost.id);

// Score each post by number of shared tags with the current post
const currentTags = new Set(currentPost.data.tags ?? []);

const scored = otherPosts
  .map((post) => {
    const sharedTags = (post.data.tags ?? []).filter((t) => currentTags.has(t));
    return { post, score: sharedTags.length };
  })
  .filter(({ score }) => score > 0) // only posts with at least 1 shared tag
  .sort((a, b) => {
    // Primary: more shared tags first
    if (b.score !== a.score) return b.score - a.score;
    // Tiebreaker: newer post first
    return b.post.data.date.getTime() - a.post.data.date.getTime();
  })
  .slice(0, 3)
  .map(({ post }) => post);

// If no related posts found, render nothing
const hasRelated = scored.length > 0;

function formatDate(date: Date): string {
  return date
    .toLocaleDateString("en-US", { month: "short", year: "numeric" })
    .toUpperCase();
}

function truncate(str: string, max: number): string {
  return str.length > max ? str.slice(0, max).trimEnd() + "…" : str;
}
---

{
  hasRelated && (
    <section class="related-posts" aria-labelledby="related-heading">
      <div class="related-header">
        <span class="label" id="related-heading">
          MORE LIKE THIS
        </span>
      </div>
      <div class="related-list" role="list">
        {scored.map((post) => (
          <article class="related-item" role="listitem">
            <a
              href={`/blog/${post.id}`}
              class="related-link"
              aria-label={`Read: ${post.data.title}`}
            >
              <div class="related-content">
                <h3 class="related-title">{post.data.title}</h3>
                <div class="related-meta">
                  <span class="label">{post.data.category}</span>
                  <span class="meta-sep" aria-hidden="true">
                    ·
                  </span>
                  <span class="label">{formatDate(post.data.date)}</span>
                  {post.data.readingTime && (
                    <>
                      <span class="meta-sep" aria-hidden="true">
                        ·
                      </span>
                      <span class="label">{post.data.readingTime} min read</span>
                    </>
                  )}
                </div>
                {post.data.description && (
                  <p class="related-desc">
                    {truncate(post.data.description, 120)}
                  </p>
                )}
              </div>
              <span class="related-arrow" aria-hidden="true">
                →
              </span>
            </a>
          </article>
        ))}
      </div>
    </section>
  )
}

<style>
  .related-posts {
    max-width: 68ch;
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--bg-border);
  }

  .related-header {
    margin-bottom: 0.75rem;
  }

  .related-list {
    display: flex;
    flex-direction: column;
  }

  .related-item {
    border-top: 1px solid var(--bg-border);
  }

  .related-item:last-child {
    border-bottom: 1px solid var(--bg-border);
  }

  .related-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.25rem 0;
    text-decoration: none;
    transition:
      background 0.2s ease,
      padding 0.2s ease;
  }

  .related-item:hover .related-link {
    background: var(--bg-surface);
    padding-left: 0.6rem;
    padding-right: 0.6rem;
    margin: 0 -0.6rem;
  }

  .related-content {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .related-title {
    font-size: 0.975rem;
    font-weight: 600;
    color: var(--ink);
    letter-spacing: -0.01em;
    line-height: 1.3;
    transition: color 0.2s ease;
  }

  .related-item:hover .related-title {
    color: var(--accent);
  }

  .related-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .meta-sep {
    color: var(--bg-border);
    font-size: 0.6rem;
  }

  .related-desc {
    font-size: 0.83rem;
    color: var(--muted);
    line-height: 1.5;
    max-width: 55ch;
    margin-top: 0.1rem;
  }

  .related-arrow {
    font-size: 0.9rem;
    color: var(--muted);
    flex-shrink: 0;
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      color 0.2s ease;
  }

  .related-item:hover .related-arrow {
    opacity: 1;
    transform: translateX(0);
    color: var(--accent);
  }
</style>
