---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

interface Props {
  currentPost: CollectionEntry<"blog">;
}

const { currentPost } = Astro.props;

// Find the single newest published article
const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const latestPost = allPosts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
)[0];

// Only show if the user is reading an older article
const isNewer = latestPost && latestPost.id !== currentPost.id;
---

{
  isNewer && (
    <div
      id="new-article-toast"
      class="toast"
      role="status"
      aria-live="polite"
      aria-atomic="true"
    >
      <a href={`/blog/${latestPost.id}`} class="toast-link" tabindex="0">
        <span class="toast-label">NEW</span>
        <span class="toast-title">{latestPost.data.title}</span>
        <span class="toast-arrow" aria-hidden="true">
          →
        </span>
      </a>
      <div class="toast-progress" aria-hidden="true" />
    </div>
  )
}

<script>
  function initToast() {
    const toast = document.getElementById("new-article-toast");
    if (!toast) return;

    // Only show once per browser session
    const sessionKey = "new-article-toast-seen";
    if (sessionStorage.getItem(sessionKey)) {
      toast.remove();
      return;
    }

    const SHOW_DELAY = 1200; // ms before appearing
    const LINGER_MS = 6000; // ms it stays visible
    const FADE_MS = 500; // ms for fade-out transition

    // Slide in after a short delay
    setTimeout(() => {
      toast.classList.add("toast--visible");

      // Start auto-dismiss countdown
      setTimeout(() => {
        toast.classList.add("toast--hiding");
        setTimeout(() => toast.remove(), FADE_MS);
      }, LINGER_MS);
    }, SHOW_DELAY);

    // Mark seen so it won't re-appear in this session
    sessionStorage.setItem(sessionKey, "1");
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initToast);
  } else {
    initToast();
  }
</script>

<style>
  .toast {
    position: fixed;
    bottom: 2rem;
    left: 2rem;
    z-index: 500;

    background: var(--ink);
    color: var(--bg);
    border-radius: 4px;
    overflow: hidden;
    max-width: 320px;
    width: max-content;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.18);

    /* Hidden by default — slides up on .toast--visible */
    opacity: 0;
    transform: translateY(12px);
    pointer-events: none;
    transition:
      opacity 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .toast--visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .toast--hiding {
    opacity: 0;
    transform: translateY(8px);
  }

  .toast-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1rem;
    text-decoration: none;
    color: inherit;
  }

  .toast-label {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-light);
    flex-shrink: 0;
  }

  .toast-title {
    font-size: 0.8rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--bg);
    /* Truncate if very long */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .toast-arrow {
    font-size: 0.8rem;
    color: var(--muted);
    flex-shrink: 0;
    transition:
      transform 0.2s ease,
      color 0.2s ease;
  }

  .toast-link:hover .toast-arrow {
    transform: translateX(3px);
    color: var(--accent-light);
  }

  /* Auto-progress bar that drains over 6s */
  .toast-progress {
    height: 2px;
    background: var(--accent);
    width: 100%;
    transform-origin: left;
    animation: toast-drain 6s 1.2s linear forwards;
  }

  @keyframes toast-drain {
    from {
      transform: scaleX(1);
    }
    to {
      transform: scaleX(0);
    }
  }

  @media (max-width: 480px) {
    .toast {
      left: 1rem;
      right: 1rem;
      bottom: 1rem;
      max-width: none;
      width: auto;
    }
  }
</style>
