---
import BaseLayout from '../layouts/BaseLayout.astro';
import Contact from '../components/Contact.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="Contact"
  description={`Get in touch with ${site.name} — backend engineer.`}
>
  <div class="contact-page-header section-py-sm">
    <div class="container">
      <p class="label label-accent">Get in touch</p>
      <h1 class="contact-page-title">Let's talk.</h1>
      <p class="contact-page-desc">
        Whether it's a project, an opportunity, or a technical problem you want
        to think through — I'm always open to a good conversation.
      </p>
    </div>
  </div>
  <Contact />
</BaseLayout>

<style>
  .contact-page-header {
    padding-bottom: 0;
  }

  .contact-page-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 7rem);
    letter-spacing: 0.02em;
    color: var(--ink);
    line-height: 1;
    margin-top: 0.75rem;
    margin-bottom: 1rem;
  }

  .contact-page-desc {
    font-size: 1rem;
    color: var(--muted);
    max-width: 45ch;
    line-height: 1.7;
  }
</style>
