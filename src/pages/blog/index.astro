---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const hasNoPosts = posts.length === 0;

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  }).toUpperCase();
}
---

<BaseLayout
  title="Blog"
  description="Technical writing by Nikhil Gautam on backend systems, databases, architecture, and engineering decisions."
>
  <div class="blog-page-header section-py-sm">
    <div class="container">
      <p class="label label-accent">Writing</p>
      <h1 class="blog-page-title">Technical<br />Writing</h1>
      <p class="blog-page-desc">
        Notes, deep-dives, and reflections on backend systems, databases,
        architecture, and engineering decisions.
      </p>
    </div>
  </div>

  <section class="section-py" aria-labelledby="articles-heading">
    <div class="container">
      <SectionHeading
        id="articles-heading"
        label="All Articles"
      />

      {hasNoPosts ? (
        <div class="blog-empty" role="status">
          <p class="blog-empty-text">No articles published yet.</p>
          <p class="blog-empty-sub">
            Writing is coming. Check back soon.
          </p>
        </div>
      ) : (
        <div class="blog-full-list" role="list">
          {posts.map((post) => (
            <article class="blog-full-item" role="listitem">
              <a href={`/blog/${post.slug}`} class="blog-full-link" aria-label={`Read: ${post.data.title}`}>
                <div class="blog-full-content">
                  <div class="blog-full-meta">
                    <span class="label label-accent">{post.data.category}</span>
                    <span class="meta-sep" aria-hidden="true">·</span>
                    <span class="label">{formatDate(post.data.date)}</span>
                    {post.data.readingTime && (
                      <>
                        <span class="meta-sep" aria-hidden="true">·</span>
                        <span class="label">{post.data.readingTime} min</span>
                      </>
                    )}
                  </div>
                  <h2 class="blog-full-title">{post.data.title}</h2>
                  {post.data.description && (
                    <p class="blog-full-desc">{post.data.description}</p>
                  )}
                  {post.data.tags.length > 0 && (
                    <div class="blog-full-tags" aria-label="Tags">
                      {post.data.tags.map((tag) => (
                        <span class="blog-tag">{tag}</span>
                      ))}
                    </div>
                  )}
                </div>
                <span class="blog-full-arrow" aria-hidden="true">→</span>
              </a>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .blog-page-header {
    padding-bottom: 0;
  }

  .blog-page-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 7rem);
    letter-spacing: 0.02em;
    color: var(--ink);
    line-height: 1;
    margin-top: 0.75rem;
    margin-bottom: 1rem;
  }

  .blog-page-desc {
    font-size: 1rem;
    color: var(--muted);
    max-width: 48ch;
    line-height: 1.7;
  }

  /* Empty state */
  .blog-empty {
    padding: 4rem 0;
    border-top: 1px solid var(--bg-border);
    border-bottom: 1px solid var(--bg-border);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .blog-empty-text {
    font-size: 1rem;
    font-weight: 500;
    color: var(--ink);
  }

  .blog-empty-sub {
    font-size: 0.9rem;
    color: var(--muted);
  }

  /* Full list */
  .blog-full-list {
    display: flex;
    flex-direction: column;
  }

  .blog-full-item {
    border-top: 1px solid var(--bg-border);
  }

  .blog-full-item:last-child {
    border-bottom: 1px solid var(--bg-border);
  }

  .blog-full-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 2rem 0;
    text-decoration: none;
    transition: background 0.2s ease, padding 0.2s ease;
  }

  .blog-full-item:hover .blog-full-link {
    background: var(--bg-surface);
    padding-left: 0.75rem;
    padding-right: 0.75rem;
    margin: 0 -0.75rem;
  }

  .blog-full-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .blog-full-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .meta-sep {
    color: var(--bg-border);
    font-size: 0.6rem;
  }

  .blog-full-title {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    font-weight: 600;
    color: var(--ink);
    letter-spacing: -0.02em;
    line-height: 1.3;
    transition: color 0.2s ease;
  }

  .blog-full-item:hover .blog-full-title {
    color: var(--accent);
  }

  .blog-full-desc {
    font-size: 0.88rem;
    color: var(--muted);
    line-height: 1.6;
    max-width: 65ch;
  }

  .blog-full-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 0.25rem;
  }

  .blog-tag {
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    border: 1px solid var(--bg-border);
    padding: 0.1rem 0.45rem;
    border-radius: 2px;
  }

  .blog-full-arrow {
    font-size: 0.9rem;
    color: var(--muted);
    flex-shrink: 0;
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.2s ease, transform 0.2s ease, color 0.2s ease;
  }

  .blog-full-item:hover .blog-full-arrow {
    opacity: 1;
    transform: translateX(0);
    color: var(--accent);
  }
</style>
